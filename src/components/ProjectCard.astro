---
import { formatMonth, lead, snippetHref, snippetParts, type Project } from "../data/site";
import { highlightCode } from "../lib/highlight";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const id = `p-${project.repo}`;
const parts = snippetParts(project.snippet.path);
const href = snippetHref(project);
const caption = `${project.repo}/${parts.file}`;
const lines = parts.end != null ? `lines ${parts.start}\u2013${parts.end}` : "";
const code = highlightCode(project.snippet.code, project.snippet.lang, parts.start);
---

<li class="project">
  <button class="trigger" type="button" aria-expanded="false" aria-controls={id}>
    <span class="head"><span class="title">{project.title}</span>{project.private && <span class="pill">private</span>}<span class="date">{formatMonth(project.date)}</span><svg class="chev" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
    <span class="desc">{project.desc}</span>
    <span class="tags">{project.tags.join(" · ")}</span>
  </button>
  <div class="panel" id={id} role="region" aria-label={`${project.title} details`} inert>
    <div class="inner">
      <div class="content">
        <ul class="facts">
          {project.facts.map((fact) => <li>{lead(fact)}</li>)}
        </ul>
        <figure class="code">
          <figcaption>
            <span>
              {href ? (
                <a href={href} target="_blank" rel="noopener">{caption}</a>
              ) : (
                caption
              )}
            </span>
            <span>{lines}</span>
          </figcaption>
          <pre><code set:html={code} /></pre>
        </figure>
        {project.private ? (
          <p class="private-note">Private repository, so there is no public link yet.</p>
        ) : (
          <a class="repo-link" href={project.url} target="_blank" rel="noopener">View on GitHub ↗</a>
        )}
      </div>
    </div>
  </div>
</li>
