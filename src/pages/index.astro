---
import "../styles/global.css";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";

const title = `${site.name} — ${site.title}`;
const canonical = new URL("/", site.url).href;
const image = new URL("/og-image.png", site.url).href;
const featured = site.projects.filter((project) => project.featured);
const more = site.projects.filter((project) => !project.featured);
const github = site.links[0].href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <main>
      <header class="intro reveal">
        <h1 id="name">{site.name}</h1>
        <p class="muted" id="role">{site.role} <a href={site.company.href} target="_blank" rel="noopener">{site.company.label}</a>{" · "}{site.location}</p>
        <p class="lede" id="intro">{site.intro}</p>
        <ul class="links">
          {
            site.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.href.startsWith("mailto:")
                    ? {}
                    : { target: "_blank", rel: "noopener" })}
                >{link.label}<span class="arrow">{link.href.startsWith("mailto:") ? "→" : "↗"}</span></a>
              </li>
            ))
          }
        </ul>
      </header>

      <section class="reveal" aria-labelledby="about-h">
        <h2 id="about-h">About</h2>
        <p class="muted">{site.about.join(" ")}</p>
      </section>

      <section class="reveal" aria-labelledby="exp-h">
        <h2 id="exp-h">Experience</h2>
        <ul class="rows">
          {
            site.experience.map((item) => (
              <li class="row">
                <div class="row-top"><span class="title">{item.href ? <a href={item.href} target="_blank" rel="noopener">{item.company}</a> : item.company}</span><span class="role">{item.role}</span><span class="date">{item.years}</span></div>
                <p class="desc">{item.line}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="reveal" aria-labelledby="featured-h">
        <h2 id="featured-h">Featured</h2>
        <ul class="projects">
          {featured.map((project) => <ProjectCard project={project} />)}
        </ul>
      </section>

      <section class="reveal" aria-labelledby="more-h">
        <h2 id="more-h">More projects</h2>
        <ul class="projects">
          {more.map((project) => <ProjectCard project={project} />)}
        </ul>
      </section>

      <section class="reveal" aria-labelledby="os-h">
        <h2 id="os-h">Open source</h2>
        <ul class="rows">
          {
            site.openSource.map((item) => (
              <li class="row">
                <div class="row-top"><a class="title" href={item.href} target="_blank" rel="noopener">{item.repo}<span class="pr"> #{item.pr}</span></a><span class="date">{item.date}</span></div>
                <p class="desc">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="reveal" aria-labelledby="edu-h">
        <h2 id="edu-h">Education</h2>
        <p class="edu"><span>{site.education.degree}, <span class="muted">{site.education.school}</span></span><span class="date">{site.education.year}</span></p>
      </section>

      <footer class="reveal">
        <p class="muted">
          More of my code is on <a href={github} target="_blank" rel="noopener">GitHub</a>.
        </p>
      </footer>
    </main>
    <script>
      import "../scripts/page.ts";
    </script>
  </body>
</html>
