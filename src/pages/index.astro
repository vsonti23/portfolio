---
import "../styles/global.css";
import { site } from "../data/site";

const title = `${site.name} — ${site.title}`;
const canonical = new URL("/", site.url).href;
const image = new URL("/og-image.png", site.url).href;
const [sst, opensearch, tekton] = site.contributions;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <main>
      <header class="intro reveal">
        <h1 id="name">{site.name}</h1>
        <p class="muted" id="role">{site.title}{" · "}{site.location}</p>
        <div id="intro">
          <p class="lede">{site.intro}</p>
          <p class="lede">{site.now} <a href={site.terros.href} target="_blank" rel="noopener">{site.terros.label}</a>. {site.outside}</p>
        </div>
        <ul class="links">
          {
            site.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.href.startsWith("mailto:")
                    ? {}
                    : { target: "_blank", rel: "noopener" })}
                >{link.label}<span class="arrow">{link.href.startsWith("mailto:") ? "→" : "↗"}</span></a>
              </li>
            ))
          }
        </ul>
      </header>

      <section class="reveal" aria-labelledby="work-h">
        <h2 id="work-h">What I've worked on</h2>
        <p class="muted">{site.work}</p>
      </section>

      <section class="reveal" aria-labelledby="tinker-h">
        <h2 id="tinker-h">Tinkering</h2>
        <ul class="rows">
          {
            site.tinkering.map((project) => (
              <li class="row muted">
                <a href={project.href} target="_blank" rel="noopener">{project.name}</a>: {project.line}
              </li>
            ))
          }
          <li class="row muted">
            {site.experiments.privateName} and <a href={site.experiments.href} target="_blank" rel="noopener">{site.experiments.name}</a>: {site.experiments.line}
          </li>
        </ul>
      </section>

      <section class="reveal" aria-labelledby="contrib-h">
        <h2 id="contrib-h">Contributions</h2>
        <p class="muted">
          I've sent fixes upstream to <a href={sst.href} target="_blank" rel="noopener">{sst.label}</a>, <a href={opensearch.href} target="_blank" rel="noopener">{opensearch.label}</a>, and <a href={tekton.href} target="_blank" rel="noopener">{tekton.label}</a>.
        </p>
      </section>

      <footer class="reveal">
        <p class="muted">
          Say hi at <a href={`mailto:${site.email}`}>{site.email}</a>, or find more on <a href={site.github} target="_blank" rel="noopener">GitHub</a>.
        </p>
      </footer>
    </main>
    <script>
      import "../scripts/page.ts";
    </script>
  </body>
</html>
