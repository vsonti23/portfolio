---
import "../styles/global.css";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";

const title = `${site.name} — ${site.title}`;
const canonical = new URL("/", site.url).href;
const image = new URL("/og-image.png", site.url).href;
const featured = site.projects.filter((project) => project.featured);
const more = site.projects.filter((project) => !project.featured);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <main>
      <header class="intro reveal">
        <h1 id="name">{site.name}</h1>
        <p class="muted" id="role">{site.title}{" · "}{site.location}</p>
        <div id="intro">
          <p class="lede">{site.intro}</p>
          <p class="lede">{site.now} <a href={site.terros.href} target="_blank" rel="noopener">{site.terros.label}</a>{site.nowRest}</p>
        </div>
        <ul class="links">
          {
            site.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.href.startsWith("mailto:")
                    ? {}
                    : { target: "_blank", rel: "noopener" })}
                >{link.label}<span class="arrow">{link.href.startsWith("mailto:") ? "→" : "↗"}</span></a>
              </li>
            ))
          }
        </ul>
      </header>

      <section class="reveal" aria-labelledby="featured-h">
        <h2 id="featured-h">Featured</h2>
        <ul class="projects">
          {featured.map((project) => <ProjectCard project={project} />)}
        </ul>
      </section>

      <section class="reveal" aria-labelledby="more-h">
        <h2 id="more-h">More projects</h2>
        <ul class="projects">
          {more.map((project) => <ProjectCard project={project} />)}
        </ul>
      </section>

      <section class="reveal" aria-labelledby="os-h">
        <h2 id="os-h">Open source</h2>
        <ul class="rows">
          {
            site.openSource.map((item) => (
              <li class="row">
                <div class="row-top"><a class="title" href={item.href} target="_blank" rel="noopener">{item.repo}<span class="pr"> #{item.pr}</span></a><span class="date">{item.date}</span></div>
                <p class="desc">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="reveal">
        <p class="muted">
          Say hi at <a href={`mailto:${site.email}`}>{site.email}</a>, or find more on <a href={site.github} target="_blank" rel="noopener">GitHub</a>.
        </p>
      </footer>
    </main>
    <script>
      import "../scripts/page.ts";
    </script>
  </body>
</html>
